{
  "name": "glossquote-subtitle-bilingual",
  "compatibility_date": "2026-10-24",
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "observability": {
    "enabled": false,
    "logs": {
      "enabled": false,
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  },
  "routes": [
    {
      "pattern": "bilingual-subs.glossquote.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./release-artifacts/site",
    "run_worker_first": false,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "build": {
    "command": "npm run build:release"
  }
}
